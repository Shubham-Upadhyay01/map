<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Emergency SOS Tracker</title>
    <link href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.0.0-beta3/css/all.min.css" rel="stylesheet">
    <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/leaflet/1.9.4/leaflet.min.css"
        integrity="sha512-h9FcoyWjHcOcmEVkxOfTLnmZFWIH0iZhZT1H2TbOq55xssQGEJHEaIm+PgoUaZbRvQTNTluNOEfb1ZRy6D3BOw=="
        crossorigin="anonymous" referrerpolicy="no-referrer" />
    <style>
        @import url('https://fonts.googleapis.com/css2?family=Inter:wght@300;400;600;700&display=swap');

        * {
            margin: 0;
            padding: 0;
            box-sizing: border-box;
        }

        :root {
            --primary-color: #ff4757;
            --secondary-color: #1a2232;
            --text-color: #e0e0e0;
            --background-color-1: #121620;
            --background-color-2: #1e2433;
            --background-color-3: #2a3242;
        }

        body, html {
            height: 100%;
            font-family: 'Inter', sans-serif;
            background-color: var(--background-color-1);
            color: var(--text-color);
            overflow: hidden;
        }

        .background-gradient {
            position: fixed;
            top: 0;
            left: 0;
            width: 100%;
            height: 100%;
            background: linear-gradient(
                -45deg, 
                var(--background-color-1), 
                var(--background-color-2), 
                var(--background-color-3), 
                var(--secondary-color)
            );
            background-size: 400% 400%;
            animation: gradientAnimation 15s ease infinite;
            z-index: -1;
        }

        @keyframes gradientAnimation {
            0% {
                background-position: 0% 50%;
            }
            50% {
                background-position: 100% 50%;
            }
            100% {
                background-position: 0% 50%;
            }
        }

        .container {
            display: flex;
            height: 100vh;
            position: relative;
            opacity: 0;
            transform: scale(0.9);
            transition: all 1s cubic-bezier(0.25, 0.46, 0.45, 0.94);
            z-index: 10;
        }

        .container.loaded {
            opacity: 1;
            transform: scale(1);
        }

        .sidebar {
            width: 35%;
            background: rgba(18, 22, 32, 0.85);
            backdrop-filter: blur(10px);
            display: flex;
            flex-direction: column;
            padding: 30px;
            overflow-y: auto;
            border-right: 1px solid rgba(255,255,255,0.05);
        }

        .sos-button {
            width: 100%;
            padding: 20px;
            background: linear-gradient(45deg, #ff4757, #ff6b6b);
            color: white;
            border: none;
            border-radius: 15px;
            font-size: 22px;
            font-weight: 700;
            text-transform: uppercase;
            letter-spacing: 2px;
            cursor: pointer;
            transition: all 0.3s ease;
            box-shadow: 0 15px 30px rgba(255,71,87,0.4);
            margin-bottom: 30px;
            position: relative;
            overflow: hidden;
        }

        .sos-button::before {
            content: '';
            position: absolute;
            top: -50%;
            left: -50%;
            width: 200%;
            height: 200%;
            background: linear-gradient(
                to right, 
                rgba(255,255,255,0) 0%, 
                rgba(255,255,255,0.2) 50%, 
                rgba(255,255,255,0) 100%
            );
            transform: rotate(45deg);
            transition: all 0.5s ease;
            opacity: 0;
        }

        .sos-button:hover::before {
            opacity: 1;
            transform: translate(50%, 50%) rotate(135deg);
        }

        .sos-button:hover {
            transform: scale(1.05);
            box-shadow: 0 20px 40px rgba(255,71,87,0.6);
        }

        .feature-section {
            background: rgba(255,255,255,0.05);
            border-radius: 15px;
            padding: 20px;
            margin-bottom: 20px;
            border: 1px solid rgba(255,255,255,0.1);
        }

        .feature-title {
            font-size: 18px;
            font-weight: 600;
            margin-bottom: 15px;
            color: var(--primary-color);
        }

        .feature-description {
            font-size: 14px;
            line-height: 1.6;
            color: rgba(224,224,224,0.8);
        }

        #map {
            width: 65%;
            height: 100%;
            background: rgba(0,0,0,0.2);
            position: relative;
        }

        @keyframes fadeInText {
            from {
                opacity: 0;
                transform: translateY(20px);
            }
            to {
                opacity: 1;
                transform: translateY(0);
            }
        }

        .animated-text {
            opacity: 0;
            animation: fadeInText 1s forwards;
        }

        @media (max-width: 768px) {
            .container {
                flex-direction: column;
            }

            .sidebar {
                width: 100%;
                height: 50%;
            }

            #map {
                width: 100%;
                height: 50%;
            }
        }
    </style>
</head>
<body>
    <div class="background-gradient"></div>
    <div class="container" id="mainContainer">
        <div class="sidebar">
            <button id="sosButton" class="sos-button animated-text" style="animation-delay: 0.2s;">
                EMERGENCY SOS
            </button>

            <div class="feature-section animated-text" style="animation-delay: 0.4s;">
                <div class="feature-title">Rapid Location Tracking</div>
                <div class="feature-description">
                    Instantly pinpoint and share your exact geographic location with emergency services in critical situations.
                </div>
            </div>

            <div class="feature-section animated-text" style="animation-delay: 0.6s;">
                <div class="feature-title">Real-Time Communication</div>
                <div class="feature-description">
                    Maintain direct communication channels with emergency responders, ensuring quick and efficient assistance.
                </div>
            </div>

            <div class="feature-section animated-text" style="animation-delay: 0.8s;">
                <div class="feature-title">Secure Emergency Protocol</div>
                <div class="feature-description">
                    Encrypted and prioritized emergency signal transmission guaranteeing your distress call reaches help immediately.
                </div>
            </div>
        </div>
        <div id="map"></div>
    </div>

    <script>
        // Smooth page load animation
        document.addEventListener('DOMContentLoaded', () => {
            const container = document.getElementById('mainContainer');
            container.classList.add('loaded');
        });
    </script>

    <script src="https://cdnjs.cloudflare.com/ajax/libs/leaflet/1.9.4/leaflet.min.js"
        integrity="sha512-puJW3E/qXDqYp9IfhAI54BJEaWIfloJ7JWs7OeD5i6ruC9JZL1gERT1wjtwXFlh7CjE7ZJ+/vcRZRkIYIb6p4g=="
        crossorigin="anonymous" referrerpolicy="no-referrer"></script>
    <script src="https://cdn.socket.io/4.8.1/socket.io.min.js"
        integrity="sha384-mkQ3/7FUtcGyoppY6bz/PORYoGqOl7/aSUMn2ymDOJcapfS6PHqxhRTMh1RR0Q6+"
        crossorigin="anonymous"></script>
    <script src="/js/script.js"></script>
</body>
</html>